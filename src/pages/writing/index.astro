---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import TagPills from "../../components/TagPills.astro";
import { tagCounts } from "../../lib/tags";
import { getListedPosts } from "../../lib/posts";

const allPosts = await getListedPosts();
const tags = tagCounts(allPosts);
---
<BaseLayout title="Writing" active="writing">
  <section class="intro">
    <div class="column">
      <h1>Writing</h1>
      <p>
        Everything I figure out ends up here — agentic AI, NLP, voice processing, and the occasional detour. {allPosts.length} post{allPosts.length === 1 ? "" : "s"} and counting.
        <br>
        Some posts are in both English and Portuguese — there's a toggle at the top of each one.
      </p>
      <TagPills tags={tags} total={allPosts.length} />
    </div>
  </section>

  <section class="list">
    <div class="column">
      <PostList posts={allPosts} />
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-block: 28px 20px;
    border-bottom: var(--divider);
    background: var(--violet-tint);
  }
  .intro h1 { margin: 0 0 8px; font: var(--type-title); letter-spacing: var(--type-display-track); }
  .intro p { margin: 0 0 16px; max-width: var(--measure-intro); font: var(--type-intro); color: var(--ink-muted); }

  .list { padding-block: 8px 30px; }
</style>

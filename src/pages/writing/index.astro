---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import TagPills from "../../components/TagPills.astro";
import { tagCounts } from "../../lib/tags";

const allPosts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const tags = tagCounts(allPosts);
---
<BaseLayout title="Writing" active="writing">
  <section class="intro">
    <div class="column">
      <h1>Writing</h1>
      <p>
        {allPosts.length} post{allPosts.length === 1 ? "" : "s"} on building agents that survive
        contact with real users. Markdown in, nothing fancy.
      </p>
      <TagPills tags={tags} total={allPosts.length} />
    </div>
  </section>

  <section class="list">
    <div class="column">
      <PostList posts={allPosts} />
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-block: 28px 20px;
    border-bottom: var(--divider);
    background: var(--violet-tint);
  }
  .intro h1 { margin: 0 0 8px; font: var(--type-title); letter-spacing: var(--type-display-track); }
  .intro p { margin: 0 0 16px; max-width: var(--measure-intro); font: var(--type-intro); color: var(--ink-muted); }

  .list { padding-block: 8px 30px; }
</style>

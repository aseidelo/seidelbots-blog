---
// A real drawing in the frame a Slot used to hold. Same card treatment as
// Slot's "illustration" kind, so replacing one with the other is invisible
// to the surrounding layout.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  /** Describe the drawing for someone who can't see it. */
  alt: string;
  /** Optional dark-theme twin of `src`. CSS picks between them. */
  srcDark?: ImageMetadata;
  height?: string;
  /** object-position, for when the subject isn't centred in the source. */
  position?: string;
  /** Set for anything above the fold — lazy loading delays the LCP there. */
  eager?: boolean;
}

const { src, alt, srcDark, height = "200px", position = "center", eager = false } = Astro.props;

// A themed pair always loads both halves up front: a hidden lazy image only
// starts downloading once shown, which makes the toggle flash.
const loading = eager || srcDark ? "eager" : "lazy";
const fetchpriority = eager ? "high" : "auto";
const widths = [400, 800];
const sizes = "(max-width: 640px) 100vw, 400px";
const style = `object-position: ${position}`;
---
<figure class="illustration" style={{ height }}>
  <Image
    src={src}
    alt={alt}
    class={srcDark ? "day" : undefined}
    widths={widths}
    sizes={sizes}
    style={style}
    loading={loading}
    fetchpriority={fetchpriority}
  />
  {srcDark && (
    <Image
      src={srcDark}
      alt={alt}
      class="night"
      widths={widths}
      sizes={sizes}
      style={style}
      loading={loading}
      fetchpriority={fetchpriority}
    />
  )}
</figure>

<style>
  .illustration {
    margin: 0;
    overflow: hidden;
    border: var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    background: var(--surface);
  }
  .illustration :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Default (no explicit choice): day, unless the OS asks for dark. */
  .illustration :global(.night) { display: none; }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .illustration :global(.day) { display: none; }
    :root:not([data-theme="light"]) .illustration :global(.night) { display: block; }
  }

  /* An explicit choice from the toggle wins over the OS. */
  :root[data-theme="light"] .illustration :global(.day) { display: block; }
  :root[data-theme="light"] .illustration :global(.night) { display: none; }
  :root[data-theme="dark"] .illustration :global(.day) { display: none; }
  :root[data-theme="dark"] .illustration :global(.night) { display: block; }
</style>
